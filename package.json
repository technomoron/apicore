{
  "name": "@technomoron/apicore",
  "version": "1.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2025-2026 Bjørn Erik Jacobsen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "cleanbuild:server": "pnpm --filter @technomoron/apicore-server run cleanbuild",
    "cleanbuild:client": "pnpm --filter @technomoron/apicore-client run cleanbuild",
    "cleanbuild": "run-s cleanbuild:server cleanbuild:client",
    "release:check": "bash ./scripts/release-check.sh",
    "release": "bash ./scripts/release.sh",
    "lintfix": "eslint --fix --no-error-on-unmatched-pattern .",
    "pretty": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,mts,vue,json,md}\"",
    "format": "run-s lintfix pretty",
    "lintconfig": "node lintconfig.cjs --auto"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "jsonc-eslint-parser": "^3.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "vite": "8.2.1"
  }
}
